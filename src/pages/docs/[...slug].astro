---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

type DocItem = CollectionEntry<'docs'>;

export async function getStaticPaths() {
  const docs = (await getCollection('docs')) as DocItem[];
  return docs.map((doc) => {
    const slug = (doc as any).slug || doc.id.replace(/\.(mdx?|md)$/, '');
    return {
      params: { slug },
      props: { doc },
    };
  });
}

interface Props {
  doc: DocItem;
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<Layout title={`${doc.data.title || 'Документация'} — Syrlas AI`}>
  <article class="max-w-4xl mx-auto px-4 py-12 prose prose-invert prose-emerald">
    <Content />
  </article>
</Layout>