---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

// Получаем все документы из src/content/docs
const docs = await getCollection('docs');
---

<Layout title="Документация — Syrlas AI">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-slate-100 mb-2">📖 Документация Syrlas AI</h1>
    <p class="text-slate-400 mb-8">Руководства, инструкции по интеграции и спецификации системы.</p>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {docs.map((doc) => {
        const slug = doc.id.replace(/\.mdx?$/, '');
        return (
          <a
            href={`${base}/docs/${slug}`}
            class="p-5 rounded-xl bg-slate-900 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-850 transition-all group"
          >
            <h2 class="text-lg font-semibold text-slate-200 group-hover:text-emerald-400 transition-colors">
              {doc.data.title || slug}
            </h2>
            {doc.data.description && (
              <p class="text-sm text-slate-400 mt-2 line-clamp-2">{doc.data.description}</p>
            )}
          </a>
        );
      })}
    </div>
  </div>
</Layout>