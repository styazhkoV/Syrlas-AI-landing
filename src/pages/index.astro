---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Specs from '../components/Specs.astro';
import UseCaseDiagram from '../components/UseCaseDiagram.astro';
import UseCases from '../components/UseCases.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import TrustAndSecurity from '../components/TrustAndSecurity.astro';
import Architecture from '../components/Architecture.astro';
---

<Layout title="Syrlas AI — Автономный личный приватный советник">
  <Hero />

  <!-- Секция Характеристики -->
  <section id="specs" class="scroll-mt-20">
    <Specs />
  </section>

  <!-- Секция Архитектура и Кейсы -->
  <section id="use-cases" class="scroll-mt-20">
    <Architecture />
    <UseCaseDiagram />
    <UseCases />
  </section>

  <!-- Секция Сравнение -->
  <section id="comparison" class="scroll-mt-20">
    <ComparisonTable />
  </section>

  <TrustAndSecurity />
</Layout>