---
import Header from '../components/Header.astro';
import FreeAccessModal from '../components/react/FreeAccessModal';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru" class="scroll-smooth bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-950 selection:bg-emerald-500/30 selection:text-emerald-300">
    <Header />
    
    <main class="flex-1">
      <slot />
    </main>

    <!-- client:load критически важен, чтобы React слушал события окна -->
    <FreeAccessModal client:load />
  </body>
</html>