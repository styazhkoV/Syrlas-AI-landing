---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { id: doc.id },
    props: { doc },
  }));
}

interface Props {
  doc: CollectionEntry<'docs'>;
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${doc.data.title} | Syrlas AI`}>
  <main class="min-h-screen bg-slate-950 text-slate-100 py-16 px-4 sm:px-6 lg:px-8">
    <article class="max-w-3xl mx-auto bg-slate-900/60 border border-slate-800/80 rounded-2xl p-6 sm:p-10 shadow-2xl">
      <div class="mb-8 border-b border-slate-800 pb-6">
        <a href={`${base}/docs`} class="text-xs font-mono text-emerald-400 hover:underline uppercase tracking-widest">← К списку статей</a>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-100 mt-4">{doc.data.title}</h1>
        <div class="flex items-center gap-4 text-xs font-mono text-slate-400 mt-3">
          <span>Автор: {doc.data.author}</span>
          <span>Дата: {doc.data.pubDate.toISOString().split('T')[0]}</span>
        </div>
      </div>

      <!-- Контент MDX -->
      <div class="prose prose-invert prose-emerald max-w-none prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800">
        <Content />
      </div>
    </article>
  </main>
</Layout>