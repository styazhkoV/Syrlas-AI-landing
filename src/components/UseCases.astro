---
const cases = [
  {
    icon: "⚖️",
    title: "Юристам и бухгалтерам",
    subtitle: "RAG-анализ документов РК",
    desc: "Быстрый оффлайн-поиск по договорам, Налоговому кодексу и нормативным актам РК без рисков утечки коммерческой тайны."
  },
  {
    icon: "🇰🇿",
    title: "Гос. сектор и делопроизводство",
    subtitle: "QazaqTili Mentor",
    desc: "Грамотное составление официальных писем и документации на государственном языке (Қазпошта, ЕГОВ, Акиматы)."
  },
  {
    icon: "📊",
    title: "Аналитикам и IT-специалистам",
    subtitle: "Локальный Code & SQL Ассистент",
    desc: "Анализ DDL-схем, генерация SQL-запросов (PostgreSQL, SQLite) и визуализация бизнес-процессов по приватным данным."
  }
];
---

<section class="py-16 bg-slate-950 border-t border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-2">Use Cases</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-100">Сценарии применения в Казахстане</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {cases.map(c => (
        <div class="bg-slate-900/60 border border-slate-800 p-6 rounded-2xl hover:border-emerald-500/40 transition-all group">
          <div class="text-4xl mb-4 group-hover:scale-110 transition-transform duration-200">{c.icon}</div>
          <div class="text-xs font-mono text-emerald-400 mb-1">{c.subtitle}</div>
          <h3 class="text-lg font-bold text-slate-100 mb-2">{c.title}</h3>
          <p class="text-xs text-slate-400 leading-relaxed">{c.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>