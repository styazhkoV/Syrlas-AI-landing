---
const userCases = [
  {
    title: "📋 Для юристов и бухгалтеров",
    desc: "Быстрый анализ сложных многостраничных договоров, актов и нормативных документов. Поиск рисков и выжимка главных условий за секунды."
  },
  {
    title: "📊 Для руководителей и бизнес-аналитиков",
    desc: "Анализ отчетов, регламентов и стратегий. Получение точной статистики и ответов без чтения 200-страничных файлов вручную."
  },
  {
    title: "🎓 Для учебы и исследований",
    desc: "Работа с научными статьями, учебниками и методичками. Конспектирование материала и генерация вопросов для проверки."
  }
];

const devCases = [
  {
    title: "⚙️ IDE & Code Assistant Integration",
    desc: "Подключение локального бэкенда к VS Code или Obsidian через Continue.dev для автономного поиска по корпоративным базам знаний."
  },
  {
    title: "🤖 Local Agent Workflows",
    desc: "Использование Syrlas AI как локального RAG-узла в скриптах Python / LangChain / Semantic Kernel без затрат на токены."
  },
  {
    title: "🏢 Sovereign Enterprise Deployment",
    desc: "Развертывание на закрытых рабочих станциях в контурах с повышенными требованиями безопасности без выхода в сеть."
  }
];
---

<section id="use-cases" class="py-16 bg-slate-950 border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <div class="text-xs font-mono text-emerald-400 uppercase tracking-widest mb-2">Scenarios</div>
      
      <h2 class="mode-user text-2xl sm:text-3xl font-extrabold text-slate-100">
        Где Syrlas AI незаменим
      </h2>
      <h2 class="mode-dev text-2xl sm:text-3xl font-extrabold text-slate-100 font-mono">
        Integration Scenarios & Workloads
      </h2>
    </div>

    <!-- Режим Пользователь -->
    <div class="mode-user grid grid-cols-1 md:grid-cols-3 gap-6">
      {userCases.map((c) => (
        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
          <h3 class="text-lg font-bold text-slate-100 mb-3">{c.title}</h3>
          <p class="text-sm text-slate-400 leading-relaxed">{c.desc}</p>
        </div>
      ))}
    </div>

    <!-- Режим Разработчик -->
    <div class="mode-dev grid grid-cols-1 md:grid-cols-3 gap-6 font-mono">
      {devCases.map((c) => (
        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
          <h3 class="text-sm font-bold text-cyan-400 mb-3">{c.title}</h3>
          <p class="text-xs text-slate-400 leading-relaxed">{c.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>