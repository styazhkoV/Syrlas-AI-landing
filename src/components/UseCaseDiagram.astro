<section class="py-16 bg-slate-950 border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="p-8 rounded-2xl bg-slate-900/40 border border-slate-800">
      
      <!-- Режим Пользователь -->
      <div class="mode-user text-center max-w-2xl mx-auto">
        <h3 class="text-xl font-bold text-slate-100 mb-4">Простой диалог с вашими документами</h3>
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-300 py-6 border-y border-slate-800">
          <div class="bg-slate-900 px-4 py-3 rounded-xl border border-slate-800">📁 Загрузка PDF/Word</div>
          <div>➔</div>
          <div class="bg-slate-900 px-4 py-3 rounded-xl border border-slate-800">💬 Ваш вопрос</div>
          <div>➔</div>
          <div class="bg-emerald-950/60 border border-emerald-500/30 text-emerald-300 px-4 py-3 rounded-xl font-semibold">💡 Точный ответ с цитатой</div>
        </div>
        <p class="text-xs text-slate-400 mt-4">Вся цепочка выполняется полностью внутри вашей операционной системы.</p>
      </div>

      <!-- Режим Разработчик -->
      <div class="mode-dev font-mono text-xs">
        <div class="text-cyan-400 font-bold mb-4">// RAG Context Retrieval Sequence</div>
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2 text-slate-400">
          <div><span class="text-emerald-400">UserQuery</span> -> [Embedder: ONNX MiniLM] -> <span class="text-slate-200">384d Dense Vector</span></div>
          <div><span class="text-emerald-400">Vector</span> -> [SQLite Vector Extension] -> <span class="text-slate-200">Top-K Chunks (Cosine Similarity)</span></div>
          <div><span class="text-emerald-400">Chunks + Prompt</span> -> [Kestrel API] -> [LLamaSharp Engine] -> <span class="text-cyan-400">Stream Output (SSE)</span></div>
        </div>
      </div>

    </div>

  </div>
</section>