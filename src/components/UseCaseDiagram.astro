---
---
<section class="py-16 bg-slate-950 border-t border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="text-xs font-mono text-emerald-400 uppercase tracking-widest mb-2">UML Architecture & Use Cases</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-100">Подробная карта сценариев использования (Use Cases)</h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-2 font-mono">
        Демонстрация абсолютной изоляции данных (Air-Gap) внутри контура вашего рабочей станции.
      </p>
    </div>

    <!-- Контейнер для SVG -->
    <div class="w-full overflow-x-auto bg-slate-900/80 border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-2xl">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 680" class="w-full h-auto min-w-[800px] text-xs font-mono">
        <defs>
          <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#0f172a" />
            <stop offset="100%" stop-color="#020617" />
          </linearGradient>
          
          <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <!-- Граница Air-Gap (Системный контур ПК) -->
        <rect x="220" y="20" width="550" height="640" rx="16" fill="url(#bgGrad)" stroke="#1e293b" stroke-width="2" />
        <rect x="230" y="30" width="530" height="620" rx="12" fill="none" stroke="#10b981" stroke-dasharray="6,6" stroke-opacity="0.4" />
        <text x="250" y="55" fill="#10b981" font-weight="bold" font-size="12">🛡️ LOCAL AIR-GAP BOUNDARY (127.0.0.1 / KESTREL SERVER)</text>

        <!-- ВНЕШНИЙ МИР (БЛОКИРОВКА) -->
        <g transform="translate(800, 280)">
          <rect x="0" y="0" width="170" height="120" rx="12" fill="#0f172a" stroke="#ef4444" stroke-width="1.5" />
          <text x="85" y="30" fill="#ef4444" text-anchor="middle" font-weight="bold" font-size="11">🌐 Внешняя сеть</text>
          <text x="85" y="48" fill="#ef4444" text-anchor="middle" font-size="10">(Cloud / ChatGPT / APIs)</text>
          <line x1="20" y1="65" x2="150" y2="65" stroke="#334155" />
          <text x="85" y="85" fill="#94a3b8" text-anchor="middle" font-size="10">⛔ Все подключения</text>
          <text x="85" y="100" fill="#ef4444" text-anchor="middle" font-weight="bold" font-size="10">ЗАБЛОКИРОВАНЫ</text>
        </g>

        <!-- АКТОРЫ (Слева) -->
        <!-- Юрист / Аналитик -->
        <g transform="translate(50, 140)">
          <circle cx="40" cy="25" r="18" fill="#1e293b" stroke="#38bdf8" stroke-width="2" />
          <path d="M 40 43 L 40 85 M 20 58 L 60 58 M 40 85 L 20 120 M 40 85 L 60 120" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" />
          <text x="40" y="138" fill="#f8fafc" text-anchor="middle" font-weight="bold" font-size="11">Юрист / Аналитик</text>
          <text x="40" y="152" fill="#64748b" text-anchor="middle" font-size="10">(B2B User)</text>
        </g>

        <!-- Разработчик / ИТ-Специалист -->
        <g transform="translate(50, 390)">
          <circle cx="40" cy="25" r="18" fill="#1e293b" stroke="#34d399" stroke-width="2" />
          <path d="M 40 43 L 40 85 M 20 58 L 60 58 M 40 85 L 60 120 M 40 85 L 60 120" stroke="#34d399" stroke-width="2" stroke-linecap="round" />
          <text x="40" y="138" fill="#f8fafc" text-anchor="middle" font-weight="bold" font-size="11">ИТ-Специалист</text>
          <text x="40" y="152" fill="#64748b" text-anchor="middle" font-size="10">(Developer / SysAdmin)</text>
        </g>

        <!-- USE CASES (Эллипсы внутри контура) -->
        
        <!-- UC1: Локальный RAG анализ -->
        <g transform="translate(270, 80)">
          <ellipse cx="140" cy="35" rx="125" ry="30" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5" />
          <text x="140" y="32" fill="#f8fafc" text-anchor="middle" font-weight="bold">UC-1: RAG-анализ файлов РК</text>
          <text x="140" y="47" fill="#94a3b8" text-anchor="middle" font-size="10">(PDF, DOCX ➔ sqlite-vec)</text>
        </g>

        <!-- UC2: QazaqTili Mentor -->
        <g transform="translate(270, 160)">
          <ellipse cx="140" cy="35" rx="125" ry="30" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5" />
          <text x="140" y="32" fill="#f8fafc" text-anchor="middle" font-weight="bold">UC-2: QazaqTili Mentor</text>
          <text x="140" y="47" fill="#94a3b8" text-anchor="middle" font-size="10">(Составление писем на гос. языке)</text>
        </g>

        <!-- UC3: Инференс локальной GGUF LLM -->
        <g transform="translate(480, 270)">
          <ellipse cx="140" cy="40" rx="130" ry="35" fill="#064e3b" stroke="#10b981" stroke-width="2" filter="url(#glow)" />
          <text x="140" y="35" fill="#34d399" text-anchor="middle" font-weight="bold">UC-3: Offline LLM Инференс</text>
          <text x="140" y="52" fill="#a7f3d0" text-anchor="middle" font-size="10">(LLamaSharp + Qwen / Llama 3)</text>
        </g>

        <!-- UC4: Запросы через OpenAI API format -->
        <g transform="translate(270, 390)">
          <ellipse cx="140" cy="35" rx="125" ry="30" fill="#1e293b" stroke="#34d399" stroke-width="1.5" />
          <text x="140" y="32" fill="#f8fafc" text-anchor="middle" font-weight="bold">UC-4: REST API Интеграция</text>
          <text x="140" y="47" fill="#94a3b8" text-anchor="middle" font-size="10">(VS Code / Obsidian ➔ LocalHost)</text>
        </g>

        <!-- UC5: Генерация SQL и анализ DDL -->
        <g transform="translate(270, 470)">
          <ellipse cx="140" cy="35" rx="125" ry="30" fill="#1e293b" stroke="#34d399" stroke-width="1.5" />
          <text x="140" y="32" fill="#f8fafc" text-anchor="middle" font-weight="bold">UC-5: Анализ SQL / DDL Схем</text>
          <text x="140" y="47" fill="#94a3b8" text-anchor="middle" font-size="10">(Генерация безопасных запросов)</text>
        </g>

        <!-- UC6: Локальная эмбеддинг-векторизация -->
        <g transform="translate(480, 550)">
          <ellipse cx="140" cy="35" rx="125" ry="30" fill="#1e293b" stroke="#0ea5e9" stroke-width="1.5" />
          <text x="140" y="32" fill="#f8fafc" text-anchor="middle" font-weight="bold">UC-6: Local Embeddings</text>
          <text x="140" y="47" fill="#94a3b8" text-anchor="middle" font-size="10">(OnnxRuntime: all-MiniLM-L6)</text>
        </g>

        <!-- СВЯЗИ АКТОРОВ С USE CASES -->
        <!-- Юрист связи -->
        <line x1="110" y1="180" x2="270" y2="115" stroke="#38bdf8" stroke-width="1.5" />
        <line x1="110" y1="180" x2="270" y2="195" stroke="#38bdf8" stroke-width="1.5" />

        <!-- Разработчик связи -->
        <line x1="110" y1="430" x2="270" y2="425" stroke="#34d399" stroke-width="1.5" />
        <line x1="110" y1="430" x2="270" y2="505" stroke="#34d399" stroke-width="1.5" />

        <!-- INCLUDES (Связи между Прецедентами) -->
        <!-- UC1 include UC3 (Offline Inference) -->
        <path d="M 500 115 Q 580 180 600 235" fill="none" stroke="#64748b" stroke-width="1.5" stroke-dasharray="4,4" />
        <polygon points="600,235 593,225 603,223" fill="#64748b" />
        <text x="560" y="160" fill="#94a3b8" font-size="9">&lt;&lt;include&gt;&gt;</text>

        <!-- UC2 include UC3 -->
        <path d="M 520 195 Q 580 220 590 235" fill="none" stroke="#64748b" stroke-width="1.5" stroke-dasharray="4,4" />
        <text x="545" y="220" fill="#94a3b8" font-size="9">&lt;&lt;include&gt;&gt;</text>

        <!-- UC4 include UC3 -->
        <path d="M 520 425 Q 580 370 600 345" fill="none" stroke="#64748b" stroke-width="1.5" stroke-dasharray="4,4" />
        <text x="550" y="380" fill="#94a3b8" font-size="9">&lt;&lt;include&gt;&gt;</text>

        <!-- UC1 include UC6 (Embeddings) -->
        <path d="M 470 140 Q 720 320 620 520" fill="none" stroke="#0ea5e9" stroke-width="1.5" stroke-dasharray="4,4" />
        <text x="670" y="310" fill="#0ea5e9" font-size="9">&lt;&lt;include&gt;&gt;</text>

        <!-- БЛОКИРОВКА СЕТИ (Линия блокировки к Cloud) -->
        <line x1="770" y1="340" x2="800" y2="340" stroke="#ef4444" stroke-width="3" stroke-dasharray="3,3" />
        <circle cx="785" cy="340" r="10" fill="#ef4444" />
        <text x="785" y="344" fill="#ffffff" text-anchor="middle" font-weight="bold" font-size="12">✕</text>
      </svg>
    </div>

    <!-- Пояснительная легенда схемы -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6 text-xs font-mono">
      <div class="bg-slate-900/60 p-3 rounded-lg border border-slate-800 flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-emerald-500 shrink-0"></span>
        <span class="text-slate-300">100% Локальный инференс в контуре (Air-Gap)</span>
      </div>
      <div class="bg-slate-900/60 p-3 rounded-lg border border-slate-800 flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-sky-400 shrink-0"></span>
        <span class="text-slate-300">Векторизация через OnnxRuntime & sqlite-vec</span>
      </div>
      <div class="bg-slate-900/60 p-3 rounded-lg border border-slate-800 flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-rose-500 shrink-0"></span>
        <span class="text-slate-300">Заблокированный внешний трафик в интернет</span>
      </div>
    </div>

  </div>
</section>