---
const userSpecs = [
  {
    icon: "🔒",
    title: "100% Приватность и тайна",
    desc: "Ваши файлы обрабатываются строго на вашем компьютере. Никакого отправки данных в облака или третьим лицам."
  },
  {
    icon: "⚡",
    title: "Мгновенный поиск ответов",
    desc: "Забудьте про листание сотен страниц. ИИ за 1 секунду найдет нужную цитату или пункт в PDF и Word файлах."
  },
  {
    icon: "✈️",
    title: "Полная автономность",
    desc: "Работает абсолютно без доступа к интернету — в дороге, самолете или в помещениях с закрытой сетью."
  },
  {
    icon: "📂",
    title: "Базы знаний по папкам",
    desc: "Разделяйте документы по темам («Юристам», «Бухгалтерии», «Проектам») и переключайте контекст в 1 клик."
  },
  {
    icon: "💰",
    title: "Без ежемесячной платы",
    desc: "Вы не платите за количество вопросов или размер загружаемых книг. Приложение полностью бесплатно."
  }
];

const devSpecs = [
  {
    tech: ".NET 8 / C# 12",
    sub: "ASP.NET Core Minimal API / Kestrel Web API (127.0.0.1:5000)",
    icon: "⚡"
  },
  {
    tech: "LLamaSharp Engine",
    sub: "C++ Native Bindings / GGUF Local LLM Inference (CUDA / Vulkan)",
    icon: "🧠"
  },
  {
    tech: "sqlite-vec & Dapper",
    sub: "Гибридный векторный + FTS5 полнотекстовый поиск в локальной SQLite",
    icon: "📦"
  },
  {
    tech: "OnnxRuntime Embeddings",
    sub: "Генерация 384d векторных эмбеддингов (all-MiniLM-L6-v2)",
    icon: "🎯"
  },
  {
    tech: "PdfPig & OpenXml",
    sub: "Локальный парсинг и структурированный чанкинг PDF / DOCX",
    icon: "📄"
  }
];
---

<section class="py-16 bg-slate-950 border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <div class="text-xs font-mono uppercase tracking-widest text-emerald-400 mb-2">Capabilities</div>
      
      <h2 class="mode-user text-2xl sm:text-3xl font-extrabold text-slate-100">
        Возможности и преимущества
      </h2>
      <h2 class="mode-dev text-2xl sm:text-3xl font-extrabold text-slate-100 font-mono">
        Архитектурный стек и модули
      </h2>
    </div>

    <!-- Режим Пользователь -->
    <div class="mode-user grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {userSpecs.map((item) => (
        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-slate-700 transition-all">
          <div class="text-3xl mb-3">{item.icon}</div>
          <h3 class="text-lg font-bold text-slate-100 mb-2">{item.title}</h3>
          <p class="text-sm text-slate-400 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>

    <!-- Режим Разработчик -->
    <div class="mode-dev grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 font-mono">
      {devSpecs.map((item) => (
        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-slate-700 transition-all">
          <div class="text-2xl mb-2">{item.icon}</div>
          <h3 class="text-base font-bold text-emerald-400 mb-1">{item.tech}</h3>
          <p class="text-xs text-slate-400 leading-relaxed">{item.sub}</p>
        </div>
      ))}
    </div>

  </div>
</section>