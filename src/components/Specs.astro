---
// Данные для Пользователя
const userSpecs = [
  {
    icon: "🔒",
    title: "Полная приватность",
    desc: "Все ваши файлы обрабатываются только внутри вашего компьютера. Никто со стороны не увидит ваши данные."
  },
  {
    icon: "⚡",
    title: "Быстрый поиск в PDF и Word",
    desc: "ИИ находит нужный пункт или ответ в документе на 100 страниц всего за 1 секунду."
  },
  {
    icon: "🔌",
    title: "Работа без интернета",
    desc: "Программа полностью автономна. Работает в дороге, самолете или в закрытых офисах без сети."
  },
  {
    icon: "📂",
    title: "Удобные базы знаний",
    desc: "Делите документы по папкам: «Юриспруденция», «Бухгалтерия» или «Инструкции» и переключайтесь в 1 клик."
  },
  {
    icon: "💰",
    title: "Без ежемесячной платы",
    desc: "Вы не платите за количество вопросов или объемы загруженных файлов. Приложение полностью бесплатно."
  }
];

// Данные для Разработчика
const devSpecs = [
  {
    tech: ".NET 8 / C# 12",
    sub: "ASP.NET Core Minimal API / Kestrel Web API (127.0.0.1)",
    icon: "⚡"
  },
  {
    tech: "LLamaSharp",
    sub: "C++ Native Bindings / GGUF Local LLM Inference",
    icon: "🧠"
  },
  {
    tech: "sqlite-vec & Dapper",
    sub: "Векторный & Текстовый RAG-поиск в локальной БД",
    icon: "📦"
  },
  {
    tech: "OnnxRuntime",
    sub: "Генерация векторных эмбеддингов (all-MiniLM-L6-v2)",
    icon: "🎯"
  },
  {
    tech: "PdfPig & OpenXml",
    sub: "Локальный парсинг и чанкинг PDF / DOCX документов",
    icon: "📄"
  }
];
---

<section class="py-16 bg-slate-950 border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <div class="text-xs font-mono uppercase tracking-widest text-emerald-400 mb-2">Capabilities</div>
      
      <h2 class="mode-user text-2xl sm:text-3xl font-extrabold text-slate-100">
        Почему это удобно и надежно
      </h2>
      <h2 class="mode-dev text-2xl sm:text-3xl font-extrabold text-slate-100 font-mono">
        Локальная бэкенд-архитектура
      </h2>
    </div>

    <!-- Карточки: Режим Пользователь -->
    <div class="mode-user grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {userSpecs.map((item) => (
        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-slate-700 transition-all">
          <div class="text-3xl mb-3">{item.icon}</div>
          <h3 class="text-lg font-bold text-slate-100 mb-2">{item.title}</h3>
          <p class="text-sm text-slate-400 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>

    <!-- Карточки: Режим Разработчик -->
    <div class="mode-dev grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 font-mono">
      {devSpecs.map((item) => (
        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-slate-700 transition-all">
          <div class="text-2xl mb-2">{item.icon}</div>
          <h3 class="text-base font-bold text-emerald-400 mb-1">{item.tech}</h3>
          <p class="text-xs text-slate-400 leading-relaxed">{item.sub}</p>
        </div>
      ))}
    </div>

  </div>
</section>