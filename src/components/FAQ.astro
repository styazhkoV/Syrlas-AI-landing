---
const userFaqs = [
  {
    q: "Зачем мне эта программа, если есть обычный ChatGPT?",
    a: "Обычный ChatGPT требует интернет, списывает деньги по подписке и может отправить ваши приватные договоры или отчеты на внешние серверы. Syrlas AI работает прямо на вашем ПК, не требует интернета и отвечает строго по загруженным вами файлам."
  },
  {
    q: "Как ИИ понимает смысл моих документов?",
    a: "При загрузке файлов программа создает специальную локальную карту памяти. Когда вы задаете вопрос, ИИ за доли секунды находит нужные страницы и абзацы, формулируя точный ответ без «фантазий»."
  },
  {
    q: "Нужен ли мощный компьютер?",
    a: "Подойдет обычный современный ноутбук или ПК. Для максимальной скорости желательна видеокарта, но программа отлично работает и на обычном процессоре."
  }
];

const devFaqs = [
  {
    q: "Какова спецификация локального REST API?",
    a: "Бэкенд Kestrel поднимает эндпоинт http://127.0.0.1:5000/v1/chat/completions, полностью совместимый со спецификацией OpenAI API (JSON Schema). Совместим с Continue.dev, LangChain и Obsidian."
  },
  {
    q: "Какой формат эмбеддингов и размерность векторов?",
    a: "Используется ONNX-модель all-MiniLM-L6-v2, генерирующая 384-мерные плотные векторы (float32), сохраняемые в локальную расширенную SQLite БД через sqlite-vec."
  },
  {
    q: "Как реализован инференс GGUF моделей?",
    a: "Вычисления выполняются через C++ нативную библиотеку LLamaSharp с поддержкой Vulkan/CUDA ускорения для Q4_K_M и Q8 квантованных моделей."
  }
];
---

<section id="faq" class="py-16 bg-slate-950 border-t border-slate-800/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <div class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-2">FAQ</div>
      
      <h2 class="mode-user text-2xl sm:text-3xl font-extrabold text-slate-100">
        Часто задаваемые вопросы
      </h2>
      <h2 class="mode-dev text-2xl sm:text-3xl font-extrabold text-slate-100 font-mono">
        Технический FAQ & API Spec
      </h2>
    </div>

    <!-- FAQ: Пользователь -->
    <div class="mode-user space-y-4">
      {userFaqs.map((item) => (
        <details class="group bg-slate-900/60 border border-slate-800 rounded-xl p-5 cursor-pointer">
          <summary class="flex items-center justify-between font-bold text-slate-200 group-open:text-emerald-400 text-base">
            <span>{item.q}</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="mt-4 text-sm text-slate-300 leading-relaxed border-t border-slate-800 pt-3">
            {item.a}
          </p>
        </details>
      ))}
    </div>

    <!-- FAQ: Разработчик -->
    <div class="mode-dev space-y-4 font-mono">
      {devFaqs.map((item) => (
        <details class="group bg-slate-900/60 border border-slate-800 rounded-xl p-5 cursor-pointer">
          <summary class="flex items-center justify-between font-bold text-slate-200 group-open:text-cyan-400 text-sm">
            <span>{item.q}</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="mt-4 text-xs text-slate-300 leading-relaxed border-t border-slate-800 pt-3">
            {item.a}
          </p>
        </details>
      ))}
    </div>

  </div>
</section>