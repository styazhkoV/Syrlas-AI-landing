---
const userFaqs = [
  {
    q: "Почему Syrlas AI лучше обычного онлайн ИИ?",
    a: "Обычный ИИ работает через интернет и передает ваши данные на чужие серверы. Syrlas AI — ваш персональный, полностью автономный хранитель информации. Он работает без интернета и читает только ваши документы."
  },
  {
    q: "Как ИИ находит ответы в моих файлах?",
    a: "При загрузке файла система за секунду выстраивает его 'смысловую карту'. Когда вы задаете вопрос, ИИ находит точный фрагмент текста и дает вам развернутый ответ со ссылкой на документ."
  },
  {
    q: "Какие документы можно загружать?",
    a: "Вы можете загружать PDF-документы, файлы Word (.docx), текстовые регламенты, договоры и инструкции любых объемов."
  }
];

const devFaqs = [
  {
    q: "Как устроен локальный эндпоинт REST API?",
    a: "Kestrel сервер предоставляет OpenAPI эндпоинт http://127.0.0.1:5000/v1/chat/completions с полной поддержкой стриминга (Server-Sent Events) и формата сообщений OpenAI."
  },
  {
    q: "Как организовано векторное хранилище?",
    a: "Используется встроенная библиотечная расширенная SQLite база данных с модулем sqlite-vec для быстрого cos-sim (косинусного) поиска векторных эмбеддингов 384d."
  },
  {
    q: "Какие квантования GGUF поддерживаются?",
    a: "Поддерживается большинство популярных моделей в форматах Q4_K_M, Q5_K_M и Q8_0 благодаря вызовам через LLamaSharp с CUDA/Vulkan акселерацией."
  }
];
---

<section id="faq" class="py-16 bg-slate-950 border-t border-slate-800/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <div class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-2">FAQ</div>
      
      <h2 class="mode-user text-2xl sm:text-3xl font-extrabold text-slate-100">
        Часто задаваемые вопросы
      </h2>
      <h2 class="mode-dev text-2xl sm:text-3xl font-extrabold text-slate-100 font-mono">
        Technical Specification & FAQ
      </h2>
    </div>

    <!-- Вопросы: Пользователь -->
    <div class="mode-user space-y-4">
      {userFaqs.map((item) => (
        <details class="group bg-slate-900/60 border border-slate-800 rounded-xl p-5 cursor-pointer">
          <summary class="flex items-center justify-between font-bold text-slate-200 group-open:text-emerald-400 text-base">
            <span>{item.q}</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="mt-4 text-sm text-slate-300 leading-relaxed border-t border-slate-800 pt-3">
            {item.a}
          </p>
        </details>
      ))}
    </div>

    <!-- Вопросы: Разработчик -->
    <div class="mode-dev space-y-4 font-mono">
      {devFaqs.map((item) => (
        <details class="group bg-slate-900/60 border border-slate-800 rounded-xl p-5 cursor-pointer">
          <summary class="flex items-center justify-between font-bold text-slate-200 group-open:text-cyan-400 text-sm">
            <span>{item.q}</span>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="mt-4 text-xs text-slate-300 leading-relaxed border-t border-slate-800 pt-3">
            {item.a}
          </p>
        </details>
      ))}
    </div>

  </div>
</section>