<!-- Плавающий переключатель режимов -->
<div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50">
  <div class="inline-flex items-center p-1.5 rounded-full bg-slate-900/90 backdrop-blur-md border border-slate-700/80 shadow-2xl shadow-emerald-500/10">
    <button
      id="global-mode-user-btn"
      type="button"
      class="px-4 py-2 rounded-full text-xs font-bold transition-all flex items-center gap-2 cursor-pointer bg-emerald-500 text-slate-950 shadow-md"
    >
      <span class="text-sm">👤</span>
      <span>Пользователь</span>
    </button>
    <button
      id="global-mode-dev-btn"
      type="button"
      class="px-4 py-2 rounded-full text-xs font-medium transition-all flex items-center gap-2 cursor-pointer text-slate-400 hover:text-slate-200"
    >
      <span class="text-sm">🛠️</span>
      <span>Разработчик</span>
    </button>
  </div>
</div>

<script>
  function initGlobalModeToggle() {
    const userBtn = document.getElementById('global-mode-user-btn');
    const devBtn = document.getElementById('global-mode-dev-btn');

    function setMode(isDev: boolean) {
      if (isDev) {
        document.body.classList.add('dev-mode');
        
        devBtn?.classList.remove('text-slate-400', 'hover:text-slate-200', 'font-medium');
        devBtn?.classList.add('bg-emerald-500', 'text-slate-950', 'font-bold', 'shadow-md');

        userBtn?.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold', 'shadow-md');
        userBtn?.classList.add('text-slate-400', 'hover:text-slate-200', 'font-medium');

        localStorage.setItem('syrlas_mode', 'dev');
      } else {
        document.body.classList.remove('dev-mode');

        userBtn?.classList.remove('text-slate-400', 'hover:text-slate-200', 'font-medium');
        userBtn?.classList.add('bg-emerald-500', 'text-slate-950', 'font-bold', 'shadow-md');

        devBtn?.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold', 'shadow-md');
        devBtn?.classList.add('text-slate-400', 'hover:text-slate-200', 'font-medium');

        localStorage.setItem('syrlas_mode', 'user');
      }
    }

    userBtn?.addEventListener('click', () => setMode(false));
    devBtn?.addEventListener('click', () => setMode(true));

    // Восстановление сохраненного режима при загрузке
    const savedMode = localStorage.getItem('syrlas_mode');
    if (savedMode === 'dev') {
      setMode(true);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlobalModeToggle);
  } else {
    initGlobalModeToggle();
  }
</script>