---
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<header class="sticky top-0 z-40 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Логотип -->
    <a href={`${base}/`} class="flex items-center gap-2 group">
      <div class="w-8 h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 font-extrabold text-lg group-hover:bg-emerald-500 group-hover:text-slate-950 transition-all">
        S
      </div>
      <span class="font-bold text-slate-100 text-lg tracking-tight">Syrlas <span class="text-emerald-400">AI</span></span>
    </a>

    <!-- Навигация: Режим Пользователь -->
    <nav class="mode-user hidden md:flex items-center gap-6 text-sm text-slate-300 font-medium">
      <a href="#capabilities" class="hover:text-emerald-400 transition-colors">Возможности</a>
      <a href="#use-cases" class="hover:text-emerald-400 transition-colors">Где применить</a>
      <a href="#security" class="hover:text-emerald-400 transition-colors">Безопасность</a>
      <a href="#comparison" class="hover:text-emerald-400 transition-colors">Сравнение</a>
      <a href="#faq" class="hover:text-emerald-400 transition-colors">Частые вопросы</a>
    </nav>

    <!-- Навигация: Режим Разработчик -->
    <nav class="mode-dev hidden md:flex items-center gap-6 text-xs font-mono text-slate-400">
      <a href="#architecture" class="hover:text-cyan-400 transition-colors">/architecture</a>
      <a href="#stack" class="hover:text-cyan-400 transition-colors">/tech-stack</a>
      <a href="#security-spec" class="hover:text-cyan-400 transition-colors">/air-gap-spec</a>
      <a href="#benchmarks" class="hover:text-cyan-400 transition-colors">/benchmarks</a>
      <a href="#faq" class="hover:text-cyan-400 transition-colors">/api-docs</a>
    </nav>

    <!-- Кнопка вызова модального окна -->
    <div>
      <button
        type="button"
        onclick="window.dispatchEvent(new CustomEvent('open-lead-modal'))"
        class="px-4 py-2 rounded-lg bg-emerald-500/10 hover:bg-emerald-500 text-emerald-400 hover:text-slate-950 border border-emerald-500/30 text-xs sm:text-sm font-semibold transition-all cursor-pointer"
      >
        <span class="mode-user">Скачать бесплатно</span>
        <span class="mode-dev font-mono">Get Binary</span>
      </button>
    </div>

  </div>
</header>