---
---

<section id="comparison" class="py-16 bg-slate-950 border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <div class="text-xs font-mono text-emerald-400 uppercase tracking-widest mb-2">Comparison</div>
      
      <h2 class="mode-user text-2xl sm:text-3xl font-extrabold text-slate-100">
        Сравнение с другими решениями
      </h2>
      <h2 class="mode-dev text-2xl sm:text-3xl font-extrabold text-slate-100 font-mono">
        Local Engine vs Cloud RAG SaaS
      </h2>
    </div>

    <!-- Режим Пользователь -->
    <div class="mode-user overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[600px]">
        <thead>
          <tr class="border-b border-slate-800 text-slate-400 text-sm">
            <th class="py-4 px-4 font-semibold">Критерий</th>
            <th class="py-4 px-4 font-semibold text-emerald-400">Syrlas AI (На ПК)</th>
            <th class="py-4 px-4 font-semibold">Облачный ChatGPT</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 text-sm">
          <tr>
            <td class="py-4 px-4 text-slate-300 font-medium">Конфиденциальность файлов</td>
            <td class="py-4 px-4 text-emerald-400 font-bold">100% Приватно (на ПК)</td>
            <td class="py-4 px-4 text-slate-500">Отправляется на чужие серверы</td>
          </tr>
          <tr>
            <td class="py-4 px-4 text-slate-300 font-medium">Работа без интернета</td>
            <td class="py-4 px-4 text-emerald-400 font-bold">Да (в самолете, дороге, бункере)</td>
            <td class="py-4 px-4 text-slate-500">Нет, требуется сеть</td>
          </tr>
          <tr>
            <td class="py-4 px-4 text-slate-300 font-medium">Стоимость использования</td>
            <td class="py-4 px-4 text-emerald-400 font-bold">Бесплатно навсегда</td>
            <td class="py-4 px-4 text-slate-500">Ежемесячная подписка</td>
          </tr>
          <tr>
            <td class="py-4 px-4 text-slate-300 font-medium">Поиск по тысячам страниц</td>
            <td class="py-4 px-4 text-emerald-400 font-bold">Мгновенный локальный поиск</td>
            <td class="py-4 px-4 text-slate-500">Ограничение на размер файлов</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Режим Разработчик -->
    <div class="mode-dev overflow-x-auto font-mono text-xs">
      <table class="w-full text-left border-collapse min-w-[600px]">
        <thead>
          <tr class="border-b border-slate-800 text-slate-400">
            <th class="py-4 px-4 font-bold">Specification Matrix</th>
            <th class="py-4 px-4 font-bold text-cyan-400">Syrlas AI Native Engine</th>
            <th class="py-4 px-4 font-bold">Cloud API (OpenAI / Anthropic)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <tr>
            <td class="py-4 px-4 text-slate-300">Data Sovereignty & Air-Gap</td>
            <td class="py-4 px-4 text-cyan-400 font-bold">Strictly Local (127.0.0.1)</td>
            <td class="py-4 px-4 text-slate-500">External Endpoint / Network Dependent</td>
          </tr>
          <tr>
            <td class="py-4 px-4 text-slate-300">Vector Search Subsystem</td>
            <td class="py-4 px-4 text-cyan-400 font-bold">sqlite-vec + FTS5 Hybrid Index</td>
            <td class="py-4 px-4 text-slate-500">Cloud Vector DB / Remote Indexing</td>
          </tr>
          <tr>
            <td class="py-4 px-4 text-slate-300">Inference Bindings</td>
            <td class="py-4 px-4 text-cyan-400 font-bold">LLamaSharp (C++ Direct Bindings)</td>
            <td class="py-4 px-4 text-slate-500">REST API Over HTTPS</td>
          </tr>
          <tr>
            <td class="py-4 px-4 text-slate-300">API Compatibility</td>
            <td class="py-4 px-4 text-cyan-400 font-bold">OpenAI Compliant (/v1/chat/completions)</td>
            <td class="py-4 px-4 text-slate-500">Proprietary Formats</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>