---

<section id="security" class="py-16 bg-slate-950 border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Карточка слайдера безопасности -->
    <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-slate-900 via-slate-900 to-emerald-950/20 border border-slate-800 relative overflow-hidden shadow-2xl">
      
      <!-- Контейнер слайдов -->
      <div id="security-slider-container" class="relative min-h-[340px] sm:min-h-[290px]">
        {securitySlides.map((item, index) => (
          <div
            class={`security-slide transition-all duration-500 ease-in-out ${index === 0 ? 'opacity-100 relative z-10 pointer-events-auto' : 'opacity-0 absolute inset-0 z-0 pointer-events-none'}`}
            data-slide-index={index}
          >
            <div class="max-w-4xl">
              
              <!-- РЕЖИМ: ПОЛЬЗОВАТЕЛЬ -->
              <div class="mode-user">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-medium mb-4">
                  {item.userBadge}
                </div>
                <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-100 mb-4 leading-tight">
                  {item.userTitle}
                </h2>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                  {item.userDesc}
                </p>
                <ul class="space-y-2 text-sm text-slate-300">
                  {item.userPoints.map((point) => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-400 font-bold">✓</span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- РЕЖИМ: РАЗРАБОТЧИК -->
              <div class="mode-dev font-mono">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs mb-4">
                  {item.devBadge}
                </div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-100 mb-4 leading-tight">
                  {item.devTitle}
                </h2>
                <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
                  {item.devDesc}
                </p>
                <div class="space-y-2 text-xs text-slate-400">
                  {item.devPoints.map((point) => (
                    <div><span class="text-cyan-400">{point.split(':')[0]}:</span>{point.substring(point.indexOf(':') + 1)}</div>
                  ))}
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>

      <!-- Элементы управления (Стрелки и Индикаторы) -->
      <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 relative z-20">
        
        <!-- Индикаторы (Dots) -->
        <div class="flex items-center gap-2" id="slider-dots">
          {securitySlides.map((_, index) => (
            <button
              type="button"
              class={`dot-btn w-3 h-3 rounded-full transition-all cursor-pointer ${index === 0 ? 'bg-emerald-500 w-8' : 'bg-slate-700 hover:bg-slate-500'}`}
              data-dot-index={index}
              aria-label={`Go to slide ${index + 1}`}
            ></button>
          ))}
        </div>

        <!-- Кнопки Назад / Вперед -->
        <div class="flex items-center gap-3">
          <button
            id="prev-slide-btn"
            type="button"
            class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 text-sm font-semibold transition-all flex items-center gap-1 cursor-pointer"
          >
            ← <span class="mode-user">Назад</span><span class="mode-dev font-mono">Prev</span>
          </button>

          <span class="text-xs font-mono text-slate-500" id="slide-counter">
            01 / 06
          </span>

          <button
            id="next-slide-btn"
            type="button"
            class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-emerald-500/10 flex items-center gap-1 cursor-pointer"
          >
            <span class="mode-user">Вперед</span><span class="mode-dev font-mono">Next</span> →
          </button>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  let currentSlide = 0;
  const totalSlides = 6;

  const slides = document.querySelectorAll('.security-slide');
  const dots = document.querySelectorAll('.dot-btn');
  const counter = document.getElementById('slide-counter');

  function updateSlider(index: number) {
    currentSlide = (index + totalSlides) % totalSlides;

    slides.forEach((slide, i) => {
      if (i === currentSlide) {
        slide.classList.remove('opacity-0', 'absolute', 'inset-0', 'pointer-events-none', 'z-0');
        slide.classList.add('opacity-100', 'relative', 'z-10', 'pointer-events-auto');
      } else {
        slide.classList.remove('opacity-100', 'relative', 'z-10', 'pointer-events-auto');
        slide.classList.add('opacity-0', 'absolute', 'inset-0', 'pointer-events-none', 'z-0');
      }
    });

    dots.forEach((dot, i) => {
      if (i === currentSlide) {
        dot.classList.add('bg-emerald-500', 'w-8');
        dot.classList.remove('bg-slate-700');
      } else {
        dot.classList.remove('bg-emerald-500', 'w-8');
        dot.classList.add('bg-slate-700');
      }
    });

    if (counter) {
      counter.textContent = `0${currentSlide + 1} / 0${totalSlides}`;
    }
  }

  document.getElementById('prev-slide-btn')?.addEventListener('click', () => updateSlider(currentSlide - 1));
  document.getElementById('next-slide-btn')?.addEventListener('click', () => updateSlider(currentSlide + 1));

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => updateSlider(index));
  });
</script>