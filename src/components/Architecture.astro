---
// Данные для бизнес-режима
const businessData = [
  {
    contour: "Контур интерфейса и доступа",
    tech: "Автономное приложение",
    role: "Локальный кабинет на компьютере. Данные не покидают устройство.",
    benefit: "🔒 100% конфиденциальность. Защита от утечек коммерческой тайны.",
    badge: "Приватность",
    badgeColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/30"
  },
  {
    contour: "Контур обработки документов",
    tech: "Анализатор PDF и DOCX",
    role: "Автоматическое считывание регламентов, договоров, отчетов и актов.",
    benefit: "⚡ Сокращение времени поиска нужных пунктов с часов до 1 секунды.",
    badge: "Скорость",
    badgeColor: "bg-cyan-500/10 text-cyan-400 border-cyan-500/30"
  },
  {
    contour: "База знаний компании",
    tech: "Модули знаний (RAG)",
    role: "Организация корпоративной памяти по отделам (Юристы, Закупки, Бухгалтерия).",
    benefit: "🔄 Мгновенная смена контекста: переключение между базами в 1 клик.",
    badge: "Универсальность",
    badgeColor: "bg-amber-500/10 text-amber-400 border-amber-500/30",
    isHighlighted: true
  },
  {
    contour: "Мозг системы (ИИ)",
    tech: "Локальный ИИ-Советник",
    role: "Генерация ответов строго на основе фактов из ваших файлов без «галлюцинаций».",
    benefit: "💰 Без ежемесячных подписок, лимитов и зависимости от интернета.",
    badge: "0 ₸ за запросы",
    badgeColor: "bg-indigo-500/10 text-indigo-400 border-indigo-500/30"
  }
];

// Данные для разработчиков
const devData = [
  {
    contour: "Presentation & Web API Layer",
    tech: "React + .NET 8 (Kestrel)",
    role: "Minimal API эндпоинты (127.0.0.1:5000), изолированный Kestrel web-сервер.",
    benefit: "Стандарт OpenAI API Spec. Совместимо с Continue.dev, Obsidian и CLI.",
    badge: "OpenAI Spec",
    badgeColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/30"
  },
  {
    contour: "Extraction & Vectorization",
    tech: "PdfPig, OpenXml + OnnxRuntime",
    role: "Парсинг DOM документов + генерация 384d векторных эмбеддингов.",
    benefit: "Модель all-MiniLM-L6-v2 заменяема без перекомпиляции бэкенда.",
    badge: "ONNX Native",
    badgeColor: "bg-cyan-500/10 text-cyan-400 border-cyan-500/30"
  },
  {
    contour: "Knowledge Core & Storage",
    tech: "sqlite-vec + Dapper",
    role: "Гибридный векторный + FTS5 полнотекстовый поиск в локальной SQLite.",
    benefit: "🔄 Hot-Swap: Моментальная подмена файла .sqlite без перезапуска бэкенда.",
    badge: "sqlite-vec",
    badgeColor: "bg-amber-500/10 text-amber-400 border-amber-500/30",
    isHighlighted: true
  },
  {
    contour: "LLM Inference Engine",
    tech: "LLamaSharp (C++ Bindings)",
    role: "Нативный C++ инференс GGUF моделей с ускорением на GPU (CUDA / Vulkan).",
    benefit: "Поддержка любых open-source моделей (Qwen 2.5, Llama 3, Saiga).",
    badge: "GGUF / CUDA",
    badgeColor: "bg-indigo-500/10 text-indigo-400 border-indigo-500/30"
  }
];
---

<section id="use-cases" class="py-16 pb-28 bg-slate-950 border-t border-slate-800/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Заголовок -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-2">Architectural Transparency</div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-100 tracking-tight">
        Архитектура и возможности системы
      </h2>
      <p class="mt-3 text-sm sm:text-base text-slate-400">
        Управляйте режимом отображения данных с помощью плавающего переключателя ниже.
      </p>
    </div>

    <!-- ТАБЛИЦА: БИЗНЕС РЕЖИМ -->
    <div id="view-business" class="architecture-view overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur-sm shadow-xl transition-all duration-300">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-800 bg-slate-900/90 text-xs uppercase font-mono text-slate-400">
            <th class="py-4 px-6">Компонент системы</th>
            <th class="py-4 px-6">Инструмент</th>
            <th class="py-4 px-6">Назначение</th>
            <th class="py-4 px-6">Выгода для компании</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 text-sm">
          {businessData.map((layer) => (
            <tr class={`transition-colors hover:bg-slate-850/60 ${layer.isHighlighted ? 'bg-amber-950/10' : ''}`}>
              <td class="py-4 px-6 font-semibold text-slate-200 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <span>{layer.contour}</span>
                  <span class={`text-[10px] px-2 py-0.5 rounded-full font-mono border ${layer.badgeColor}`}>
                    {layer.badge}
                  </span>
                </div>
              </td>
              <td class="py-4 px-6 font-mono text-xs text-cyan-300 font-medium whitespace-nowrap">
                {layer.tech}
              </td>
              <td class="py-4 px-6 text-slate-300 min-w-[240px] leading-relaxed">
                {layer.role}
              </td>
              <td class={`py-4 px-6 text-xs sm:text-sm leading-relaxed min-w-[260px] ${layer.isHighlighted ? 'text-amber-300 font-semibold' : 'text-emerald-400 font-medium'}`}>
                {layer.benefit}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- ТАБЛИЦА: DEV РЕЖИМ (СКРЫТА ПО УМОЛЧАНИЮ) -->
    <div id="view-dev" class="architecture-view hidden overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur-sm shadow-xl transition-all duration-300">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-800 bg-slate-900/90 text-xs uppercase font-mono text-slate-400">
            <th class="py-4 px-6">Архитектурный слой</th>
            <th class="py-4 px-6">Стек / Библиотеки</th>
            <th class="py-4 px-6">Техническая логика</th>
            <th class="py-4 px-6">Гибкость & Интеграция</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 text-sm">
          {devData.map((layer) => (
            <tr class={`transition-colors hover:bg-slate-850/60 ${layer.isHighlighted ? 'bg-amber-950/10' : ''}`}>
              <td class="py-4 px-6 font-semibold text-slate-200 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <span>{layer.contour}</span>
                  <span class={`text-[10px] px-2 py-0.5 rounded-full font-mono border ${layer.badgeColor}`}>
                    {layer.badge}
                  </span>
                </div>
              </td>
              <td class="py-4 px-6 font-mono text-xs text-cyan-300 font-medium whitespace-nowrap">
                {layer.tech}
              </td>
              <td class="py-4 px-6 text-slate-300 min-w-[240px] leading-relaxed">
                {layer.role}
              </td>
              <td class={`py-4 px-6 text-xs sm:text-sm leading-relaxed min-w-[260px] ${layer.isHighlighted ? 'text-amber-300 font-semibold' : 'text-slate-300 font-mono'}`}>
                {layer.benefit}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Информационный баннер -->
    <div class="mt-6 p-4 rounded-xl bg-slate-900/80 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center gap-4 text-xs text-slate-300">
      <div class="p-2.5 rounded-lg bg-emerald-500/10 text-emerald-400 text-xl shrink-0">
        💡
      </div>
      <div class="flex-1 leading-relaxed">
        <span id="banner-text-business" class="block">
          <strong class="text-slate-100">Изолированный контур безопасности:</strong> Syrlas AI не отправляет ваши документы в облако. Все вычисления производятся локально на вашем оборудовании.
        </span>
        <span id="banner-text-dev" class="hidden">
          <strong class="text-slate-100">Hot-Swap RAG Engine:</strong> Переключение между `.sqlite` файлами баз данных происходит налету через Dapper + `sqlite-vec` без разрыва TCP-соединений.
        </span>
      </div>
    </div>

  </div>

  <!-- ПЛАВАЮЩИЙ ТУМБЛЕР (FLOATING GLASS PILL) ПО ЦЕНТРУ СНИЗУ -->
  <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 w-auto max-w-[95vw]">
    <div class="bg-slate-900/85 backdrop-blur-xl p-1.5 rounded-full border border-slate-700/80 shadow-2xl shadow-emerald-950/40 flex items-center gap-1">
      <button
        id="btn-mode-business"
        type="button"
        class="mode-btn px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all flex items-center gap-2 bg-emerald-500 text-slate-950 shadow-md shadow-emerald-500/20 whitespace-nowrap cursor-pointer"
      >
        <span>💼</span>
        <span>Бизнес & Аналитика</span>
      </button>

      <button
        id="btn-mode-dev"
        type="button"
        class="mode-btn px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all flex items-center gap-2 text-slate-400 hover:text-slate-200 whitespace-nowrap cursor-pointer"
      >
        <span>🛠️</span>
        <span>DevOps & Разработчик</span>
      </button>
    </div>
  </div>
</section>

<script>
  const btnBusiness = document.getElementById('btn-mode-business');
  const btnDev = document.getElementById('btn-mode-dev');
  const viewBusiness = document.getElementById('view-business');
  const viewDev = document.getElementById('view-dev');
  const bannerBusiness = document.getElementById('banner-text-business');
  const bannerDev = document.getElementById('banner-text-dev');

  function setMode(mode: 'business' | 'dev') {
    if (mode === 'business') {
      // Стилизация активной кнопки Бизнес
      btnBusiness?.classList.add('bg-emerald-500', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20');
      btnBusiness?.classList.remove('text-slate-400', 'hover:text-slate-200');
      
      btnDev?.classList.remove('bg-emerald-500', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20');
      btnDev?.classList.add('text-slate-400', 'hover:text-slate-200');

      // Переключение таблиц
      viewBusiness?.classList.remove('hidden');
      viewDev?.classList.add('hidden');

      // Переключение баннера
      bannerBusiness?.classList.remove('hidden');
      bannerDev?.classList.add('hidden');
    } else {
      // Стилизация активной кнопки Dev
      btnDev?.classList.add('bg-emerald-500', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20');
      btnDev?.classList.remove('text-slate-400', 'hover:text-slate-200');
      
      btnBusiness?.classList.remove('bg-emerald-500', 'text-slate-950', 'shadow-md', 'shadow-emerald-500/20');
      btnBusiness?.classList.add('text-slate-400', 'hover:text-slate-200');

      // Переключение таблиц
      viewDev?.classList.remove('hidden');
      viewBusiness?.classList.add('hidden');

      // Переключение баннера
      bannerDev?.classList.remove('hidden');
      bannerBusiness?.classList.add('hidden');
    }
  }

  btnBusiness?.addEventListener('click', () => setMode('business'));
  btnDev?.addEventListener('click', () => setMode('dev'));
</script>