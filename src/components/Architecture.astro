---
const stackItems = [
  { name: ".NET 8 / C# 12", role: "ASP.NET Core Minimal API / Kestrel Web API (127.0.0.1)", icon: "⚡" },
  { name: "LLamaSharp", role: "C++ Native Bindings / GGUF Local LLM Inference", icon: "🧠" },
  { name: "sqlite-vec & Dapper", role: "Векторный & Текстовый RAG-поиск в локальной БД", icon: "📦" },
  { name: "OnnxRuntime", role: "Генерация векторных эмбеддингов (all-MiniLM-L6-v2)", icon: "🎯" },
  { name: "PdfPig & OpenXml", role: "Локальный парсинг и чанкинг PDF / DOCX документов", icon: "📄" },
];
---

<section class="py-16 bg-slate-950 border-t border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-2">Architectural Transparency</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-100">Локальная бэкенд-архитектура</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
      {stackItems.map(item => (
        <div class="bg-slate-900/60 border border-slate-800 p-4 rounded-xl flex flex-col justify-between">
          <div>
            <div class="text-2xl mb-2">{item.icon}</div>
            <div class="font-bold text-slate-100 text-sm font-mono">{item.name}</div>
          </div>
          <div class="text-[11px] text-slate-400 mt-3 leading-snug">{item.role}</div>
        </div>
      ))}
    </div>
  </div>
</section>